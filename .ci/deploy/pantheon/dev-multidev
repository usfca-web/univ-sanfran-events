#!/bin/bash

set -eo pipefail

#
# This script deploys the build artifact to Pantheon.
# On the master branch the dev environment is used.
# Otherwise a multidev environment is used.
#

# Cut gitignore at the cut mark.
terminus build:gitignore:cut

# Authenticate with Terminus
terminus -n auth:login --machine-token="$TERMINUS_TOKEN"

if [[ $CI_BRANCH != $DEFAULT_BRANCH ]]
then
  # Create a new multidev environment (or push to an existing one)
  terminus -n build:env:create "$TERMINUS_SITE.dev" "$TERMINUS_ENV" --yes
  terminus -n workflow:wait "$TERMINUS_SITE.$TERMINUS_ENV" --max=600
else
  # Push to the dev environment
  terminus -n build:env:push "$TERMINUS_SITE.dev" --yes
fi

# Code sync can finish before a new multidev database is ready.
# Drush status may exit successfully without bootstrapping Drupal, so check its value.
for attempt in {1..20}; do
  echo "Checking Drupal readiness for $TERMINUS_SITE.$TERMINUS_ENV (attempt $attempt/20)..."
  if bootstrap=$(terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- status --field=bootstrap) &&
     [[ "$bootstrap" == "Successful" ]]; then
    break
  fi

  if [[ "$attempt" -eq 20 ]]; then
    echo "Drupal could not bootstrap. Check Pantheon provisioning and the target database before retrying." >&2
    exit 1
  fi
  sleep 30
done

# If exported configuration is available, then import it first.
if [ -f "config/system.site.yml" ] ; then
  echo "Importing configuration before database updates..."
  terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- config-import --yes
fi

# Now update the Drupal database
echo "Running database updates..."
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- updatedb -y

# Clear Drupal cache
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- cr

# Clear the environment cache
terminus -n env:clear-cache $TERMINUS_SITE.$TERMINUS_ENV

# Ensure secrets are set
terminus -n secrets:set "$TERMINUS_SITE.$TERMINUS_ENV" token "${GH_TOKEN:-$GITHUB_TOKEN}" --file='.build-secrets/tokens.json' --clear --skip-if-empty
# Delete old multidev environments associated
# with a PR that has been merged or closed.
terminus -n build:env:delete:pr $TERMINUS_SITE --yes
