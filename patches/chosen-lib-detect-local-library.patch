+/**
+ * Gets the first matching Chosen asset filename from a directory.
+ *
+ * @param string $directory
+ *   The absolute directory path.
+ * @param array $candidates
+ *   Candidate filenames in priority order.
+ *
+ * @return string|false
+ *   The matching filename, or FALSE if none were found.
+ */
+function _chosen_lib_get_chosen_asset($directory, array $candidates) {
+  foreach ($candidates as $candidate) {
+    if (file_exists($directory . '/' . $candidate)) {
+      return $candidate;
