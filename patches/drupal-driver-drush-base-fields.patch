@@ -426,6 +426,56 @@ class DrushDriver extends BaseDriver {
     }
   }
 
+  /**
+   * {@inheritdoc}
+   */
+  public function isBaseField($entity_type, $field_name) {
+    $base_fields = [
+      'node' => [
+        'title',
+        'status',
+        'uid',
+        'created',
+        'changed',
+        'promote',
+        'sticky',
+        'langcode',
+      ],
+      'taxonomy_term' => [
+        'name',
+        'description',
+        'parent',
+        'status',
+        'langcode',
+      ],
+      'user' => [
+        'name',
+        'mail',
+        'status',
+        'roles',
+        'created',
+        'changed',
+        'access',
+        'login',
+        'langcode',
+      ],
+    ];
+
+    if (isset($base_fields[$entity_type]) && in_array($field_name, $base_fields[$entity_type], TRUE)) {
+      return TRUE;
+    }
+
+    try {
+      $value = [$entity_type, $field_name];
+      $arguments = ['is-base-field', escapeshellarg(json_encode($value))];
+      $result = $this->drush('behat', $arguments, []);
+      return strpos($result, "true\n") !== FALSE;
+    }
+    catch (\Exception $exception) {
+      return FALSE;
+    }
+  }
+
